Bootstrap: docker
From: ghcr.io/astral-sh/uv:0.12.9-python3.12-trixie-slim

%files
    pyproject.toml /workspace/pyproject.toml
    uv.lock /workspace/uv.lock
    README.md /workspace/README.md
    src /workspace/src

%post
    cd /workspace
    UV_PROJECT_ENVIRONMENT=/opt/pcn-venv uv sync --frozen --no-dev

%environment
    export UV_PROJECT_ENVIRONMENT=/opt/pcn-venv
    export PATH=/opt/pcn-venv/bin:$PATH
    export PYTHONUNBUFFERED=1

%runscript
    cd /workspace
    exec uv run --frozen --no-sync pcn-gridsearch \
        --data-dir /workspace/data \
        --out-dir /workspace/out/gridsearch \
        --device cuda \
        "$@"
